generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Supplier {
  CARPIGIANI
  TAYLOR
  BRAVO
  NISSEI
  ELECTROLUX
  GRAM
  TECNICHE
  ITALGEL
  PREGEL
}

enum Department {
  Production
  Marketing
  Maintenance
  QualityControl
  Logistics
  Accounting
  HumanResources
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String
  refreshToken String?  @db.Text
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  STAFF
}

enum ProductCategory {
  Machine
  Ingredient
  Flavoring
  Packaging
  Utensil
  Instruction
}

enum ProductUnit {
  Unit
  Piece
  Kilogram
  Bottle
  Box
  Copy
  Pack
}

model Product {
  id          String          @id @default(uuid())
  productId   String          @unique
  name        String
  category    ProductCategory
  unit        ProductUnit
  price       Float
  minStock    Int             @default(10)
  quantity    Int             @default(0)
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  StockIns  StockIn[]
  StockOuts StockOut[]
}

model StockIn {
  id        String   @id @default(uuid())
  reference String   @unique
  date      DateTime
  supplier  Supplier
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Float
}

model StockOut {
  id         String     @id @default(uuid())
  reference  String     @unique
  date       DateTime
  department Department
  requester  String
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relations
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Float
}
